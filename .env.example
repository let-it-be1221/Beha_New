APP_NAME="Beha"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Addis_Ababa
APP_URL=http://localhost:8000

# Organization
ORG_NAME="Beha Real Estate"
ORG_LOGO_PATH="images/logo.png"

# ID Generation
OFFICIAL_ID_PREFIX=BH
OFFICIAL_ID_PAD_LENGTH=6
CUSTOMER_REF_PREFIX=CUS
ASSET_CODE_PREFIX=AST
CONFIDENTIAL_ID_FORMAT="{yy}-{GG}-{BB}-{TT}-{RR}"
CONFIDENTIAL_ID_DELIMITER="-"

# Organizational capacity
TEAM_MEMBER_CAPACITY=10
TEAM_CAPACITY_PER_BRANCH=10
BRANCH_CAPACITY_PER_GENERATION=10

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=beha
DB_USERNAME=root
DB_PASSWORD=

# Redis / Cache / Queue
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Filesystem
FILESYSTEM_DISK=local

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="noreply@beha.example"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum
SANCTUM_STATEFUL_DOMAINS="localhost,localhost:8000,127.0.0.1,127.0.0.1:8000"
SESSION_DOMAIN=localhost

# Security
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_MIXED_CASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SYMBOL=true
TEMP_PASSWORD_TTL_HOURS=24
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15

# Audit
AUDIT_LOG_RETENTION_DAYS=365
