# Beha Backend — Laravel 12 API
# XAMPP MySQL defaults — adjust as needed

APP_NAME="Beha API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Addis_Ababa
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Organization
ORG_NAME="Beha Real Estate"
ORG_LOGO_PATH="images/logo.png"

# ID Generation
OFFICIAL_ID_PREFIX=BH
OFFICIAL_ID_PAD_LENGTH=6
CUSTOMER_REF_PREFIX=CUS
ASSET_CODE_PREFIX=AST
CONFIDENTIAL_ID_FORMAT="{yy}-{GG}-{BB}-{TT}-{RR}"
CONFIDENTIAL_ID_DELIMITER="-"

# Organizational capacity
TEAM_MEMBER_CAPACITY=10
TEAM_CAPACITY_PER_BRANCH=10
BRANCH_CAPACITY_PER_GENERATION=10

# Database — XAMPP defaults
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=beha_new
DB_USERNAME=root
DB_PASSWORD=

# Cache / Queue / Session — use file/db for local dev, switch to Redis for production
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# Redis (optional — only if you have it installed)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Filesystem
FILESYSTEM_DISK=local

# Mail (use log for local dev)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@beha.local"
MAIL_FROM_NAME="${APP_NAME}"

# CORS / Sanctum SPA
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8000"
SANCTUM_STATEFUL_DOMAINS="localhost,localhost:5173,localhost:8000,127.0.0.1,127.0.0.1:5173"
SESSION_DOMAIN=".localhost"
SESSION_SAME_SITE=lax

# Security
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_MIXED_CASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SYMBOL=true
TEMP_PASSWORD_TTL_HOURS=24
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15

# Audit
AUDIT_LOG_RETENTION_DAYS=365
